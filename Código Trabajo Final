,"        const docLinkHtml = 'Like what you see? Visit the ' +\n","          '<a target=\"_blank\" href=https://colab.research.google.com/notebooks/data_table.ipynb>data table notebook</a>'\n","          + ' to learn more about interactive tables.';\n","        element.innerHTML = '';\n","        dataTable['output_type'] = 'display_data';\n","        await google.colab.output.renderOutput(dataTable, element);\n","        const docLink = document.createElement('div');\n","        docLink.innerHTML = docLinkHtml;\n","        element.appendChild(docLink);\n","      }\n","    </script>\n","  </div>\n","\n","\n","    </div>\n","  </div>\n"],"application/vnd.google.colaboratory.intrinsic+json":{"type":"dataframe","summary":"{\n  \"name\": \"plt\",\n  \"rows\": 10,\n  \"fields\": [\n    {\n      \"column\": \"G\\u00e9nero\",\n      \"properties\": {\n        \"dtype\": \"string\",\n        \"num_unique_values\": 10,\n        \"samples\": [\n          \"Action\",\n          \"Comedy\",\n          \"Animation\"\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"Cantidad de Pel\\u00edculas\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 110,\n        \"min\": 42,\n        \"max\": 406,\n        \"num_unique_values\": 10,\n        \"samples\": [\n          43,\n          88,\n          53\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"}},"metadata":{}},{"output_type":"stream","name":"stderr","text":["/tmp/ipykernel_5246/1878222825.py:21: FutureWarning:\n","\n","\n","\n","Passing `palette` without assigning `hue` is deprecated and will be removed in v0.14.0. Assign the `y` variable to `hue` and set `legend=False` for the same effect.\n","\n","\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1200x600 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["import pandas as pd\n","import numpy as np\n","import re\n","\n","def cargar_y_limpiar_datos(df_source):\n","    \"\"\"\n","    Adapta el DataFrame df_top500 para el sistema de recomendación,\n","    renombrando columnas y añadiendo placeholders para datos faltantes.\n","    \"\"\"\n","    df = df_source.copy()\n","\n","    # Renombrar columnas para que coincidan con la estructura esperada por las funciones de quiz/filtro\n","    df = df.rename(columns={\n","        'title': 'título',\n","        'year': 'año',\n","        'country': 'país o región',\n","        'averageRating': 'rating de Letterboxd'\n","    })\n","\n","    # Renombrar columnas de directores\n","    director_cols_map = {f'director/{i}': f'director{i}' for i in range(3) if f'director/{i}' in df.columns}\n","    df = df.rename(columns=director_cols_map)\n","\n","    # Renombrar columnas de géneros\n","    genre_cols_map = {f'genres/{i}': f'género{i}' for i in range(8) if f'genres/{i}' in df.columns}\n","    df = df.rename(columns=genre_cols_map)\n","\n","    # Añadir columnas faltantes con valores por defecto\n","    if 'sinopsis' not in df.columns:\n","        df['sinopsis'] = '' # Sinopsis no está disponible en df_top500\n","    if 'duración (minutos)' not in df.columns:\n","        df['duración (minutos)'] = 120 # Valor por defecto, ya que la duración no está en df_top500\n","    if 'idioma' not in df.columns:\n","        df['idioma'] = 'inglés' # Valor por defecto, ya que el idioma no está en df_top500\n","\n","    # Limpieza básica de strings y normalización de textos\n","    columnas_str = ['título', 'sinopsis', 'idioma', 'país o región'] + list(director_cols_map.values())\n","    for col in columnas_str:\n","        if col in df.columns:\n","            df[col] = df[col].astype(str).str.strip()\n","\n","    # Normalizar columnas de géneros\n","    for i in range(8):\n","        col_gen = f'género{i}'\n","        if col_gen in df.columns:\n","            df[col_gen] = df[col_gen].astype(str).str.strip().str.capitalize()\n","\n","    return df\n","\n","def ejecutar_quiz():\n","    \"\"\"\n","    Despliega el cuestionario interactivo mediante la consola de entrada.\n","    \"\"\"\n","    print(\"=\" * 60)\n","    print(\" BIENVENIDO AL QUIZ INTERACTIVO DE RECOMENDACIÓN DE PELÍCULAS\")\n","    print(\"=\" * 60)\n","    print(\"Por favor, responde a las siguientes preguntas indicando el número o texto según corresponda:\\n\")\n","\n","    # 1. Género\n","    print(\"1. ¿Qué género te gustaría ver hoy?\")\n","    print(\"Opciones: Drama, Comedia, Acción, Thriller, Terror, Romance, Ciencia ficción, Animación, Documental, Fantasía, Crimen, Aventura, Musical, Guerra, Western, Ninguno\")\n","    gen_pref = input(\"Tu respuesta: \").strip().capitalize()\n","\n","    # 2. Duración\n","    print(\"\\n2. ¿Qué duración prefieres?\")\n","    print(\"1: Menos de 90 minutos\\n2: 90–120 minutos\\n3: 120–150 minutos\\n4: Más de 150 minutos\\n5: Me da igual\")\n","    dur_opt = input(\"Tu respuesta (número): \").strip()\n","\n","    # 3. Época\n","    print(\"\\n3. ¿De qué época prefieres la película?\")\n","    print(\"1: Antes de 1970\\n2: 1970–1989\\n3: 1990–2009\\n4: 2010+\\n5: No importa\")\n","    ep_opt = input(\"Tu respuesta (número): \").strip()\n","\n","    # 4. Rating\n","    print(\"\\n4. ¿Qué calificación mínima en Letterboxd buscas?\")\n","    print(\"1: 3.5+\\n2: 4.0+\\n3: 4.3+\\n4: Top rated (4.5+)\\n5: Me da igual\")\n","    rat_opt = input(\"Tu respuesta (número): \").strip()\n","\n","    # 5. Región\n","    print(\"\\n5. ¿De qué región te gustaría ver una película?\")\n","    print(\"Opciones: USA/Canadá, Europa, Asia, Latinoamérica, África, Oceanía, Cualquiera\")\n","    region_opt = input(\"Tu respuesta: \").strip().lower()\n","\n","    # 6. Idioma\n","    print(\"\\n6. ¿Qué prefieres respecto al idioma?\")\n","    print(\"1: Español\\n2: Español/Inglés\\n3: Cualquier idioma\\n4: Descubrir otros (No inglés/español)\")\n","    id_opt = input(\"Tu respuesta (número): \").strip()\n","\n","    # 7. Experiencia emocional\n","    print(\"\\n7. ¿Qué tipo de experiencia buscas?\")\n","    print(\"Opciones: Emocionarme, Reflexionar, Suspenso, Reír, Sorprenderme, Indiferente\")\n","    exp_opt = input(\"Tu respuesta: \").strip().lower()\n","\n","    # 8. Géneros a evitar\n","    print(\"\\n8. ¿Quieres evitar algún género? (Indica géneros separados por comas o escribe 'ninguno')\")\n","    evitar_opt = input(\"Tu respuesta: \").strip().lower()\n","\n","    # 9. Director\n","    print(\"\\n9. ¿Hay algún director que te guste especialmente? (Opcional, presiona Enter para saltar)\")\n","    dir_opt = input(\"Tu respuesta: \").strip().lower()\n","\n","    # 10. Cantidad de recomendaciones\n","    print(\"\\n10. ¿Cuántas recomendaciones deseas?\")\n","    print(\"Opciones: 1, 3 o 5\")\n","    n_recom = input(\"Tu respuesta: \").strip()\n","    try:\n","        n_recom = int(n_recom)\n","        if n_recom not in [1, 3, 5]:\n","            n_recom = 3\n","    except ValueError:\n","        n_recom = 3\n","\n","    respuestas = {\n","        'genero': gen_pref,\n","        'duracion': dur_opt,\n","        'epoca': ep_opt,\n","        'rating': rat_opt,\n","        'region': region_opt,\n","        'idioma': id_opt,\n","        'experiencia': exp_opt,\n","        'evitar': evitar_opt,\n","        'director': dir_opt,\n","        'cantidad': n_recom\n","    }\n","    return respuestas\n","\n","def filtrar_y_puntuar(df, respuestas):\n","    \"\"\"\n","    Aplica filtros duros según selección y calcula un sistema de scoring adaptativo.\n","    \"\"\"\n","    df_filtrado = df.copy()\n","\n","    # ---- 1. FILTRADO DURO DE GÉNEROS A EVITAR ----\n","    if respuestas['evitar'] != 'ninguno' and respuestas['evitar'] != '':\n","        generos_evitar = [g.strip().capitalize() for g in respuestas['evitar'].split(',')]\n","        for g_evitar in generos_evitar:\n","            for i in range(8):\n","                # Asegurarse de que la columna exista antes de intentar filtrar\n","                if f'género{i}' in df_filtrado.columns:\n","                    df_filtrado = df_filtrado[df_filtrado[f'género{i}'] != g_evitar]\n","\n","    # ---- 2. ASIGNACIÓN DE SCORING INTELIGENTE ----\n","    df_filtrado['score'] = 0.0\n","\n","    # Coincidencia de Género Preferido (Peso Muy Alto: +3 puntos)\n","    if respuestas['genero'] != 'Ninguno' and respuestas['genero'] != '':\n","        gen_mask = pd.Series(False, index=df_filtrado.index)\n","        for i in range(8):\n","            if f'género{i}' in df_filtrado.columns:\n","                gen_mask = gen_mask | (df_filtrado[f'género{i}'] == respuestas['genero'])\n","        df_filtrado.loc[gen_mask, 'score'] += 3.0\n","\n","    # Coincidencia de Experiencia Emocional inferida de sinopsis (Peso Alto: +2 puntos)\n","    dic_palabras_clave = {\n","        'emocionarme': ['llorar', 'amor', 'drama', 'emoción', 'conmovedor', 'familia', 'triste', 'vida'],\n","        'reflexionar': ['filosofía', 'mente', 'pensar', 'existencial', 'sociedad', 'realidad', 'humano', 'moral'],\n","        'suspenso': ['misterio', 'crimen', 'asesinato', 'tensión', 'peligro', 'secreto', 'investigación', 'terror'],\n","        'reír': ['comedia', 'divertido', 'humor', 'chiste', 'risa', 'sátira', 'parodia'],\n","        'sorprenderme': ['giro', 'inesperado', 'secreto', 'magia', 'ciencia ficción', 'fantasía', 'viaje', 'descubrir']\n","    }\n","\n","    exp = respuestas['experiencia']\n","    if exp in dic_palabras_clave:\n","        keywords = dic_palabras_clave[exp]\n","        regex_pattern = '|'.join(keywords)\n","        # Asegurarse de que la columna 'sinopsis' exista\n","        if 'sinopsis' in df_filtrado.columns:\n","            sinopsis_match = df_filtrado['sinopsis'].str.contains(regex_pattern, case=False, na=False)\n","            df_filtrado.loc[sinopsis_match, 'score'] += 2.0\n","\n","    # Rating de Letterboxd (Peso Alto: Máximo +2 puntos proporcionales)\n","    # Escala el rating de manera que las mejor valoradas sumen más al score final\n","    if 'rating de Letterboxd' in df_filtrado.columns:\n","        df_filtrado['score'] += (df_filtrado['rating de Letterboxd'].fillna(0) / 5.0) * 2.0\n","\n","    # ---- 3. APLICACIÓN DE FILTROS ADAPTATIVOS / FLEXIBLES ----\n","\n","    # Filtro de Duración\n","    dur = respuestas['duracion']\n","    if 'duración (minutos)' in df_filtrado.columns:\n","        if dur == '1': # Menos de 90\n","            df_filtrado.loc[df_filtrado['duración (minutos)'] < 90, 'score'] += 1.0\n","        elif dur == '2': # 90-120\n","            df_filtrado.loc[(df_filtrado['duración (minutos)'] >= 90) & (df_filtrado['duración (minutos)'] <= 120), 'score'] += 1.0\n","        elif dur == '3': # 120-150\n","            df_filtrado.loc[(df_filtrado['duración (minutos)'] > 120) & (df_filtrado['duración (minutos)'] <= 150), 'score'] += 1.0\n","        elif dur == '4': # Más de 150\n","            df_filtrado.loc[df_filtrado['duración (minutos)'] > 150, 'score'] += 1.0\n","\n","    # Filtro de Época\n","    ep = respuestas['epoca']\n","    if 'año' in df_filtrado.columns:\n","        if ep == '1': # Antes de 1970\n","            df_filtrado.loc[df_filtrado['año'] < 1970, 'score'] += 1.0\n","        elif ep == '2': # 1970-1989\n","            df_filtrado.loc[(df_filtrado['año'] >= 1970) & (df_filtrado['año'] <= 1989), 'score'] += 1.0\n","        elif ep == '3': # 1990-2009\n","            df_filtrado.loc[(df_filtrado['año'] >= 1990) & (df_filtrado['año'] <= 2009), 'score'] += 1.0\n","        elif ep == '4': # 2010+\n","            df_filtrado.loc[df_filtrado['año'] >= 2010, 'score'] += 1.0\n","\n","    # Filtro estricto / flexible de Rating Mínimo solicitado\n","    rat = respuestas['rating']\n","    if 'rating de Letterboxd' in df_filtrado.columns:\n","        if rat == '1': df_filtrado = df_filtrado[df_filtrado['rating de Letterboxd'] >= 3.5]\n","        elif rat == '2': df_filtrado = df_filtrado[df_filtrado['rating de Letterboxd'] >= 4.0]\n","        elif rat == '3': df_filtrado = df_filtrado[df_filtrado['rating de Letterboxd'] >= 4.3]\n","        elif rat == '4': df_filtrado = df_filtrado[df_filtrado['rating de Letterboxd'] >= 4.5]\n","\n","    # Región\n","    reg = respuestas['region']\n","    if reg != 'cualquiera' and reg != '':\n","        mapa_regiones = {\n","            'usa/canadá': ['estados unidos', 'canadá', 'usa', 'united states', 'canada', 'estados unidos o canadá'],\n","            'europa': ['europa', 'francia', 'españa', 'reino unido', 'italia', 'alemania'],\n","            'asia': ['asia', 'japón', 'corea', 'china', 'india'],\n","            'latinoamérica': ['latinoamérica', 'argentina', 'méxico', 'brasil', 'chile', 'colombia'],\n","            'áfrica': ['áfrica', 'sudáfrica', 'egipto', 'nigeria'],\n","            'oceanía': ['oceanía', 'australia', 'nueva zelanda']\n","        }\n","        if reg in mapa_regiones and 'país o región' in df_filtrado.columns:\n","            reg_mask = df_filtrado['país o región'].str.lower().isin(mapa_regiones[reg])\n","            df_filtrado.loc[reg_mask, 'score'] += 1.0\n","\n","    # Idioma\n","    idioma_opt = respuestas['idioma']\n","    if 'idioma' in df_filtrado.columns:\n","        if idioma_opt == '1': # Solo español\n","            df_filtrado = df_filtrado[df_filtrado['idioma'].str.lower() == 'español']\n","        elif idioma_opt == '2': # Español o inglés\n","            df_filtrado = df_filtrado[df_filtrado['idioma'].str.lower().isin(['español', 'inglés', 'english'])]\n","        elif idioma_opt == '4': # Descubrir otros\n","            df_filtrado = df_filtrado[~df_filtrado['idioma'].str.lower().isin(['español', 'inglés', 'english'])]\n","\n","    # Director Favorito (Suma de bonus de +1.5)\n","    if respuestas['director'] != '':\n","        dir_mask = pd.Series(False, index=df_filtrado.index)\n","        for i in range(3):\n","            col_dir = f'director{i}'\n","            if col_dir in df_filtrado.columns:\n","                dir_mask = dir_mask | (df_filtrado[col_dir].str.lower() == respuestas['director'])\n","        df_filtrado.loc[dir_mask, 'score'] += 1.5\n","\n","    # Ordenar por score de afinidad y romper empates usando el rating de Letterboxd de forma descendente\n","    if 'rating de Letterboxd' in df_filtrado.columns:\n","        df_filtrado = df_filtrado.sort_values(by=['score', 'rating de Letterboxd'], ascending=[False, False])\n","    else:\n","        df_filtrado = df_filtrado.sort_values(by='score', ascending=False)\n","\n","\n","    return df_filtrado\n","\n","def mostrar_recomendaciones(df_resultados, respuestas):\n","    \"\"\"\n","    Imprime el output en el formato estricto solicitado.\n","    \"\"\"\n","    from IPython.display import HTML, display # Ensure these are imported here too if not globally\n","\n","    n_mostrar = min(len(df_resultados), respuestas['cantidad'])\n","\n","    if n_mostrar == 0:\n","        print(\"\\n==================================\")\n","        print(\"No se encontraron películas que coincidan exactamente con tus criterios de filtrado.\")\n","        print(\"Prueba ampliando los rangos de selección o reduciendo las restricciones.\")\n","        print(\"==================================\")\n","        return\n","\n","    print(f\"\\n Basado en tus respuestas, estas son tus {n_mostrar} mejores recomendaciones cinematográficas:\\n\")\n","\n","    for idx in range(n_mostrar):\n","        peli = df_resultados.iloc[idx]\n","\n","        # Recuperar géneros válidos omitiendo nulos/vacíos\n","        generos = []\n","        for i in range(8):\n","            gen_col = f'género{i}'\n","            if gen_col in peli.index:\n","                gen = peli[gen_col]\n","                if pd.notna(gen) and str(gen).strip() != '' and str(gen).lower() != 'nan':\n","                    generos.append(str(gen))\n","        generos_str = \", \".join(generos)\n","\n","        # Recuperar directores válidos\n","        directores = []\n","        for i in range(3):\n","            col_dir = f'director{i}'\n","            if col_dir in peli.index and pd.notna(peli[col_dir]) and str(peli[col_dir]).strip() != '' and str(peli[col_dir]).lower() != 'nan':\n","                directores.append(str(peli[col_dir]))\n","        directores_str = \", \".join(directores)\n","\n","        # Generar argumento dinámico de recomendación\n","        motivos = []\n","        if respuestas['genero'] != 'Ninguno' and respuestas['genero'] in generos:\n","            motivos.append(f\"coincide perfectamente con tu deseo de ver un film de {respuestas['genero']}\")\n","        if respuestas['experiencia'] != 'indiferente':\n","            motivos.append(f\"su trama está especialmente alineada a tu búsqueda de {respuestas['experiencia']}\")\n","        if 'rating de Letterboxd' in peli.index and float(peli['rating de Letterboxd']) >= 4.0:\n","            motivos.append(f\"cuenta con un excelente respaldo crítico de {peli['rating de Letterboxd']} en la comunidad cinéfila\")\n","\n","        por_que = \"Esta obra maestra te la sugiero porque \" + \" y \".join(motivos[:2]) + \".\" if motivos else \"Es una de las obras con mayor afinidad y calidad dentro de tus filtros elegidos.\"\n","\n","        # Retrieve poster URL\n","        poster_url = peli[\"posterUrl\"] if \"posterUrl\" in peli.index and pd.notna(peli[\"posterUrl\"]) else \"\"\n","\n","        # Output in structured HTML format\n","        movie_info_html = \"\"\n","        if poster_url:\n","            movie_info_html += f\"<div style='display:flex; align-items:center; margin-bottom: 20px;'>\"\n","            movie_info_html += f\"<img src='{poster_url}' style='width:100px; height:auto; margin-right:15px;'>\"\n","            movie_info_html += f\"<div>\"\n","        else:\n","            movie_info_html += f\"<div>\"\n","\n","        movie_info_html += f\"  <strong>Título:</strong> {peli['título']}<br>\"\n","        movie_info_html += f\"  <strong>Año:</strong> {int(peli['año'])}<br>\"\n","        movie_info_html += f\"  <strong>Director:</strong> {directores_str}<br>\"\n","        movie_info_html += f\"  <strong>Calificación Promedio (Ranking):</strong> {peli['rating de Letterboxd']}<br>\"\n","        movie_info_html += f\"  <strong>Duración:</strong> {int(peli['duración (minutos)'])} minutos<br>\"\n","        movie_info_html += f\"  <strong>País:</strong> {peli['país o región']}<br>\"\n","        movie_info_html += f\"  <strong>Géneros:</strong> {generos_str}<br>\"\n","        movie_info_html += f\"  <strong>Por qué te lo recomiendo:</strong> {por_que}<br>\"\n","        movie_info_html += f\"</div>\"\n","\n","        if poster_url:\n","            movie_info_html += f\"</div>\"\n","\n","        display(HTML(movie_info_html))\n","        print(\"-----------------------------------------\")\n","    print(\"==================================\")\n","\n","# ---- EJECUCIÓN PRINCIPAL DEL NOTEBOOK ----\n","# Cargar df_top500 para asegurar su disponibilidad\n","df_top500 = pd.read_csv(\"/content/top500.csv\")\n","\n","# Pasar df_top500 directamente a la función de carga y limpieza\n","df_peliculas = cargar_y_limpiar_datos(df_top500)\n","\n","print(\"Unique genres in the dataset after cleaning:\")\n","all_cleaned_genres = set()\n","for i in range(8):\n","    col_gen = f'género{i}'\n","    if col_gen in df_peliculas.columns:\n","        all_cleaned_genres.update(df_peliculas[col_gen].dropna().unique())\n","\n","# Remove empty strings or 'nan' if they appear\n","all_cleaned_genres = {g for g in all_cleaned_genres if g and g.lower() != 'nan'}\n","\n","print(sorted(list(all_cleaned_genres)))\n","\n","respuestas_usuario = ejecutar_quiz()\n","resultados = filtrar_y_puntuar(df_peliculas, respuestas_usuario)\n","mostrar_recomendaciones(resultados, respuestas_usuario)\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"RaOJY2jmrZVi","outputId":"ec6d85fe-f0d5-4520-f6fc-c8ae85954cbb","executionInfo":{"status":"ok","timestamp":1