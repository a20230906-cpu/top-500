one en columnas\n","country_count = df_top500[\"country\"].value_counts().reset_index()\n","country_count.columns = [\"country\", \"Cantidad de películas\"]\n","\n","#Ilustra el mapa\n","fig = px.choropleth(\n","    country_count,\n","#Define las variables para mostrarse\n","    locations=\"country\",\n","    locationmode=\"country names\",\n","    color=\"Cantidad de películas\",\n","#Crea la barra de películas\n","    hover_name=\"country\",\n","    hover_data=[\"Cantidad de películas\"],\n","    color_continuous_scale=\"Greens\",\n","#Titulo del mapa\n","    title=\"Cantidad de películas del Top 500 por país\"\n",")\n","#Da tamaño al mapa.\n","fig.update_layout(\n","    width=1000,\n","    height=600\n",")\n","\n","fig.show()"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"G7g60Oa6XI5y","colab":{"base_uri":"https://localhost:8080/","height":176},"executionInfo":{"status":"ok","timestamp":1783107801467,"user_tz":300,"elapsed":4214,"user":{"displayName":"MARIANO JOAQUÍN VENEGAS IBAÑEZ","userId":"06077999206209794000"}},"outputId":"d5d12c22-75b5-40aa-d7e0-d1a9fc13d4b8"},"outputs":[{"output_type":"stream","name":"stdout","text":["Escribe el nombre del país para ver sus películas: Cuba\n","Películas de Cuba (Top 500):\n","\n"]},{"output_type":"display_data","data":{"text/plain":["<IPython.core.display.HTML object>"],"text/html":["<div style='display:flex; align-items:center; margin-bottom: 20px;'><img src='https://a.ltrbxd.com/resized/sm/upload/pj/tf/dy/af/wFy2WSxIpa8CBvo2EZ3oW3wOxDJ-1200-1200-675-675-crop-000000.jpg?v=b375dcb5e5' style='width:100px; height:auto; margin-right:15px;'><div>  <strong>Título:</strong> I Am Cuba<br>  <strong>Año:</strong> 1964<br>  <strong>Director:</strong> Mikheil Kalatozishvili<br>  <strong>Calificación Promedio (Ranking):</strong> 4.46<br></div></div>"]},"metadata":{}},{"output_type":"stream","name":"stdout","text":["-----------------------------------------\n"]}],"source":["#Importa archivos para mostrarlos\n","from IP